// AOT_LINK_SLOT marks a slot whose expression is a constant expression naming
// a symbol in this binary. Such slots behave exactly like AOT_SLOT at runtime
// but generated code may reference them through a relocation resolved by the
// static linker instead of an indirection table load. The expression must be
// spellable outside any class it belongs to, because the image shim repeats it
// at namespace scope. The symbol must also be hidden: an exported one may be
// interposed, so its address is not fixed until load time and the link fails.

// TODO(Justin): Reorganize the order of different slot types, currently messy.

// Runtime

AOT_SLOT(JSRuntimePtr,           rt)
AOT_SLOT(JSContextPtr,           cx)
AOT_SLOT(InterruptBits,          cx->addressOfInterruptBits())
AOT_SLOT(JitActivation,          cx->addressOfJitActivation())
AOT_SLOT(ContextRealm,           reinterpret_cast<uint8_t*>(cx) + JSContext::offsetOfRealm())
AOT_SLOT(WellKnownSymbols,       rt->wellKnownSymbols.ref())
AOT_SLOT(LastBufferedCell,       rt->gc.addressOfLastBufferedWholeCell())
AOT_SLOT(ProfilerEnabled,        rt->geckoProfiler().addressOfEnabled())
AOT_SLOT(ProfilerExitFrameTail,  getProfilerExitFrameTail().value)
AOT_SLOT(DoubleToInt32Stub,      getDoubleToInt32ValueStub().value)
AOT_SLOT(MegamorphicCache,       &rt->caches().megamorphicCache)
AOT_SLOT(MegamorphicSetPropCache, rt->caches().megamorphicSetPropCache.get())
AOT_SLOT(StringToAtomCache,      &rt->caches().stringToAtomCache)
AOT_SLOT(ExceptionTail,          getExceptionTail().value)
AOT_SLOT(DebugTrapInterpreter,   debugTrapHandler(DebugTrapHandlerKind::Interpreter)->raw())
AOT_SLOT(DebugTrapCompiler,      debugTrapHandler(DebugTrapHandlerKind::Compiler)->raw())
AOT_SLOT(InterpretOp,            baselineInterpreter_.interpretOpAddr().value)
AOT_SLOT(NurseryPosition,        rt->gc.addressOfNurseryPosition())
AOT_SLOT(NurseryAllocatedSites,  rt->gc.addressOfNurseryAllocatedSites())
AOT_SLOT(JitStackLimit,          cx->addressOfJitStackLimit())
#ifdef JS_GC_ZEAL
AOT_SLOT(GCZealModeBits,         rt->gc.addressOfZealModeBits())
#endif

// Pre barriers

AOT_SLOT(PreBarrier_Value,       preBarrier(MIRType::Value).value)
AOT_SLOT(PreBarrier_String,      preBarrier(MIRType::String).value)
AOT_SLOT(PreBarrier_Object,      preBarrier(MIRType::Object).value)
AOT_SLOT(PreBarrier_Shape,       preBarrier(MIRType::Shape).value)
AOT_SLOT(PreBarrier_WasmAnyRef,  preBarrier(MIRType::WasmAnyRef).value)

// Pointers from the atoms zone used while generating GC pointer operands

AOT_ATOM_SLOT(AtomEmpty,              static_cast<JSString*>(cx->names().empty_))
AOT_ATOM_SLOT(AtomTrue,               static_cast<JSString*>(cx->names().true_))
AOT_ATOM_SLOT(AtomFalse,              static_cast<JSString*>(cx->names().false_))
AOT_ATOM_SLOT(AtomFunction,           static_cast<JSString*>(cx->names().function))
AOT_ATOM_SLOT(AtomUndefined,          static_cast<JSString*>(cx->names().undefined))
AOT_ATOM_SLOT(AtomNull,               static_cast<JSString*>(cx->names().null))
AOT_ATOM_SLOT(AtomObject,             static_cast<JSString*>(cx->names().object))

// JavaScript class pointers

AOT_LINK_SLOT(Class_WithEnvironment,              &WithEnvironmentObject::class_)
AOT_LINK_SLOT(Class_Function,                     &FunctionClass)
AOT_LINK_SLOT(Class_ExtendedFunction,             &ExtendedFunctionClass)
AOT_LINK_SLOT(Class_Array,                        &ArrayObject::class_)
AOT_LINK_SLOT(Class_PlainObject,                  &PlainObject::class_)
AOT_LINK_SLOT(Class_FixedLengthArrayBuffer,       &FixedLengthArrayBufferObject::class_)
AOT_LINK_SLOT(Class_ImmutableArrayBuffer,         &ImmutableArrayBufferObject::class_)
AOT_LINK_SLOT(Class_ResizableArrayBuffer,         &ResizableArrayBufferObject::class_)
AOT_LINK_SLOT(Class_FixedLengthSharedArrayBuffer, &FixedLengthSharedArrayBufferObject::class_)
AOT_LINK_SLOT(Class_GrowableSharedArrayBuffer,    &GrowableSharedArrayBufferObject::class_)
AOT_LINK_SLOT(Class_FixedLengthDataView,          &FixedLengthDataViewObject::class_)
AOT_LINK_SLOT(Class_ImmutableDataView,            &ImmutableDataViewObject::class_)
AOT_LINK_SLOT(Class_ResizableDataView,            &ResizableDataViewObject::class_)
AOT_LINK_SLOT(Class_MappedArguments,              &MappedArgumentsObject::class_)
AOT_LINK_SLOT(Class_UnmappedArguments,            &UnmappedArgumentsObject::class_)
AOT_LINK_SLOT(Class_BoundFunction,                &BoundFunctionObject::class_)
AOT_LINK_SLOT(Class_PropertyIterator,             &PropertyIteratorObject::class_)
AOT_LINK_SLOT(Class_Set,                          &SetObject::class_)
AOT_LINK_SLOT(Class_Map,                          &MapObject::class_)
AOT_LINK_SLOT(Class_Date,                         &DateObject::class_)
AOT_LINK_SLOT(Class_WeakMap,                      &WeakMapObject::class_)
AOT_LINK_SLOT(Class_WeakSet,                      &WeakSetObject::class_)
AOT_LINK_SLOT(Class_Generator,                    &GeneratorObject::class_)

// Supplied by the embedder rather than defined here.
AOT_SLOT(Class_WindowProxy,                  rt->maybeWindowProxyClass())

// Other pointers
AOT_LINK_SLOT(Ptr_DeadObjectProxy,          &DeadObjectProxy::singleton)
AOT_LINK_SLOT(Ptr_MathRandomScaleInv,       &js::jit::MathRandomScaleInv)
AOT_SLOT(Ptr_WrapperFamily,                 &js::Wrapper::family)

// The following resolve to file static objects, private members, embedder
// supplied addresses, or exported symbols, so they have no spelling the linker
// can bind.
AOT_SLOT(Ptr_EmptyObjectSlots,              emptyObjectSlots)
AOT_SLOT(Ptr_EmptyObjectElements,           emptyObjectElements)
AOT_SLOT(Ptr_StaticStrings_Unit,            &cx->staticStrings().unitStaticTable)
AOT_SLOT(Ptr_StaticStrings_Length2,         &cx->staticStrings().length2StaticTable)
AOT_SLOT(Ptr_StaticStrings_Int,             &cx->staticStrings().intStaticTable)
AOT_SLOT(Ptr_StaticStrings_SmallChar,       &StaticStrings::toSmallCharTable.storage)
AOT_SLOT(Ptr_DateTimeInfo_UTCOffset,        DateTimeInfo::addressOfUTCToLocalOffsetSeconds())
AOT_SLOT(Ptr_DOMProxyHandlerFamily,         GetDOMProxyHandlerFamily())

// The three typed array class tables are contiguous. Add an indirection slot
// for every address that range checks and type dispatch may access.
AOT_LINK_SLOT(Ptr_TypedArrayClasses_FixedLength_Begin,       std::begin(TypedArrayObject::fixedLengthClasses))
AOT_LINK_SLOT(Ptr_TypedArrayClasses_FixedLength_End,         std::end(TypedArrayObject::fixedLengthClasses))
AOT_LINK_SLOT(Ptr_TypedArrayClasses_Immutable_LastElem,      std::prev(std::end(TypedArrayObject::immutableClasses)))
AOT_LINK_SLOT(Ptr_TypedArrayClasses_Resizable_Begin,         std::begin(TypedArrayObject::resizableClasses))
AOT_LINK_SLOT(Ptr_TypedArrayClasses_Resizable_End,           std::end(TypedArrayObject::resizableClasses))
AOT_LINK_SLOT(Ptr_TypedArrayClasses_Resizable_LastElem,      std::prev(std::end(TypedArrayObject::resizableClasses)))
AOT_LINK_SLOT(Ptr_TypedArrayClasses_FixedLength_Int16,       &TypedArrayObject::fixedLengthClasses[Scalar::Int16])
AOT_LINK_SLOT(Ptr_TypedArrayClasses_FixedLength_Int32,       &TypedArrayObject::fixedLengthClasses[Scalar::Int32])
AOT_LINK_SLOT(Ptr_TypedArrayClasses_FixedLength_Float64,     &TypedArrayObject::fixedLengthClasses[Scalar::Float64])
AOT_LINK_SLOT(Ptr_TypedArrayClasses_FixedLength_Uint8Clamped, &TypedArrayObject::fixedLengthClasses[Scalar::Uint8Clamped])
AOT_LINK_SLOT(Ptr_TypedArrayClasses_FixedLength_BigInt64,    &TypedArrayObject::fixedLengthClasses[Scalar::BigInt64])
AOT_LINK_SLOT(Ptr_TypedArrayClasses_FixedLength_Float16,     &TypedArrayObject::fixedLengthClasses[Scalar::Float16])
AOT_LINK_SLOT(Ptr_TypedArrayClasses_Resizable_Int16,         &TypedArrayObject::resizableClasses[Scalar::Int16])
AOT_LINK_SLOT(Ptr_TypedArrayClasses_Resizable_Int32,         &TypedArrayObject::resizableClasses[Scalar::Int32])
AOT_LINK_SLOT(Ptr_TypedArrayClasses_Resizable_Float64,       &TypedArrayObject::resizableClasses[Scalar::Float64])
AOT_LINK_SLOT(Ptr_TypedArrayClasses_Resizable_Uint8Clamped,  &TypedArrayObject::resizableClasses[Scalar::Uint8Clamped])
AOT_LINK_SLOT(Ptr_TypedArrayClasses_Resizable_BigInt64,      &TypedArrayObject::resizableClasses[Scalar::BigInt64])
AOT_LINK_SLOT(Ptr_TypedArrayClasses_Resizable_Float16,       &TypedArrayObject::resizableClasses[Scalar::Float16])
